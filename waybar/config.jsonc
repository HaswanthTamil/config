{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 0,

  "include": [
    "~/.config/waybar/modules/left/active_workspace.jsonc",
    "~/.config/waybar/modules/left/workspaces.jsonc",
    "~/.config/waybar/modules/left/resources.jsonc",
    "~/.config/waybar/modules/left/drawer.jsonc",
    "~/.config/waybar/modules/left/media.jsonc",
    "~/.config/waybar/modules/left/visualizer.jsonc",
    "~/.config/waybar/modules/center/clock.jsonc",
    "~/.config/waybar/modules/center/weather.jsonc",
    "~/.config/waybar/modules/center/drawer.jsonc",
    "~/.config/waybar/modules/center/notifications.jsonc",
    "~/.config/waybar/modules/right/timer.jsonc",
    "~/.config/waybar/modules/right/nightmode.jsonc",
    "~/.config/waybar/modules/right/cpu.jsonc",
    "~/.config/waybar/modules/right/memory.jsonc",
    "~/.config/waybar/modules/right/network.jsonc",
    "~/.config/waybar/modules/right/bluetooth.jsonc",
    "~/.config/waybar/modules/right/output.jsonc",
    "~/.config/waybar/modules/right/input.jsonc",
    "~/.config/waybar/modules/right/power.jsonc",
    "~/.config/waybar/modules/right/battery.jsonc",
    "~/.config/waybar/modules/right/drawer.jsonc"
  ],

  "modules-left": [
    "custom/active-workspace",
    "custom/media",
    "custom/visualizer"
  ],

  "modules-center": [
    "clock",
    "custom/notification-dot"
  ],

  "modules-right": [
    "group/controls-group"
  ],

  "group/controls-group": {
    "orientation": "horizontal",
    "modules": [
      "custom/cpu-temp",
      "custom/memory",
      "custom/audio-output",
      "custom/audio-input",
      "custom/battery",
      "custom/bluetooth",
      "custom/network",
      "custom/power"
    ]
  }
}
